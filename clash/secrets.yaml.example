# Fills <ui_password> in config.yaml, including the commented-out `secret:` line
ui_password:

# Copy to clash/secrets.yaml (git-ignored) and fill in, then run scripts/render.sh.
# Each key replaces the matching <key> placeholder in clash/config.yaml.
proxy_provider_url_amy:
proxy_provider_url_tag:
proxy_provider_url_lxy:

amy_doh_token:

# Node-domain remapping. Paste the `hosts:` section of each subscription under
# its own key (the entries only, without the `hosts:` header). Clash renders
# both; Surge renders only hosts_tag. Exact duplicates are ignored.
hosts_amy:
  # <uuid>.node.example: <uuid>.target.example
hosts_tag:
  # <uuid>.node.example: <uuid>.target.example
