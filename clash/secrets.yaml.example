# Copy to clash/secrets.yaml (git-ignored) and fill in, then run scripts/render.sh.
# Each key replaces the matching <key> placeholder in clash/config.yaml.
proxy_provider_amy_url:
proxy_provider_tag_url:
proxy_provider_lxy_url:
amy_doh_token:
# Fills <ui_password> in config.yaml, including the commented-out `secret:` line
ui_password:

# Node-domain remapping. Paste the `hosts:` section of the amy and tag
# subscriptions here as-is (header included). Exact duplicates are ignored.
hosts:
  # <uuid>.node.example: <uuid>.target.example
